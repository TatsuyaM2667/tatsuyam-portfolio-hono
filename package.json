{
  "name": "tatsuyam-portfolio-hono",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:fe": "cd frontend && trunk build --release",
    "build:be": "bun build.ts",
    "build": "bun run build:fe && bun run build:be",
    "dev": "bun run --parallel dev:server dev:trunk",
    "dev:server": "bun run --hot server/dev.ts",
    "dev:trunk": "cd frontend && trunk serve",
    "start": "bun run server/dev.ts",
    "deploy": "bun run build && wrangler deploy",
    "preview": "bun run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "wrangler": "^4.111.0"
  }
}
